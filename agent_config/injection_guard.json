{
  "_note": "Prompt-injection guard (pipeline stage 1b, right after classify). Deterministic: scores the raw customer text and every free-text entity the classifier extracted. Each pattern counts once; the turn is blocked when the summed weight reaches `block_threshold`. Weight 3 = strong signal on its own; 1-2 = needs company. Techniques are InjectionTechnique values.",
  "enabled": true,
  "block_threshold": 3,
  "max_decoded_chars": 2000,
  "patterns": [
    {"id": "override_instructions", "technique": "instruction_override", "weight": 3,
     "regex": "\\b(ignore|disregard|forget|override|bypass|discard)\\b.{0,30}\\b(previous|prior|above|earlier|all|any|your|the|these|those|every)\\b.{0,30}\\b(instructions?|rules?|prompts?|guidelines?|policies|policy|directives?|restrictions?|programming)\\b"},
    {"id": "new_instructions", "technique": "instruction_override", "weight": 3,
     "regex": "\\b(new|updated|revised|real|actual)\\s+(instructions?|rules|directives?)\\s*[:\\-]"},
    {"id": "stop_following_rules", "technique": "instruction_override", "weight": 3,
     "regex": "\\b(stop|quit|cease)\\s+(following|obeying|using)\\s+(your|the|these)\\s+(rules|instructions|guidelines|policies)"},
    {"id": "reveal_prompt", "technique": "prompt_extraction", "weight": 3,
     "regex": "\\b(reveal|show|print|repeat|output|display|leak|recite|tell me|give me|share)\\b.{0,30}\\b(system|initial|hidden|original|secret|developer)\\s+(prompt|instructions?|message|rules)"},
    {"id": "your_instructions", "technique": "prompt_extraction", "weight": 2,
     "regex": "\\b(what (are|were)|repeat|print|show)\\b.{0,20}\\byour\\s+(instructions|system prompt|rules|prompt|guidelines)"},
    {"id": "jailbreak_terms", "technique": "role_play", "weight": 3,
     "regex": "\\b(dan mode|developer mode|jailbreak(?:ed)?|do anything now|god mode|unrestricted mode|no restrictions|without (any )?restrictions)\\b"},
    {"id": "role_reassign", "technique": "role_play", "weight": 2,
     "regex": "\\b(you are now|from now on,? you (are|will)|pretend (to be|you are|that you)|role-?play as|simulate being|act as (if you (are|were)|an? (admin|developer|unfiltered|different|new)))\\b"},
    {"id": "claim_staff", "technique": "impersonation", "weight": 2,
     "regex": "\\b(i am|i'm|this is)\\s+(the |an? |your )?(admin|administrator|developer|system|owner|ceo|store manager|support staff|employee|engineer)\\b"},
    {"id": "claim_authority", "technique": "impersonation", "weight": 3,
     "regex": "\\b(authori[sz]ed|permitted|approved|cleared)\\s+(by|to)\\b.{0,40}\\b(override|bypass|refund|discount|admin|management)"},
    {"id": "free_money", "technique": "policy_bypass", "weight": 2,
     "regex": "\\b(100\\s?%\\s*(off|discount|refund)|unlimited (discount|credit|refunds?)|free (shoes|pairs?|order)\\b)"},
    {"id": "approve_override", "technique": "policy_bypass", "weight": 2,
     "regex": "\\b(approve|authori[sz]e|process|issue|grant)\\b.{0,30}\\b(without (checking|verif\\w*|approval|review)|regardless of (the )?(policy|rules|window))"},
    {"id": "bypass_controls", "technique": "policy_bypass", "weight": 3,
     "regex": "\\b(bypass|skip|disable|turn off|circumvent)\\b.{0,25}\\b(return window|policy|policies|verification|authentication|sign-?in|login|safety|filters?|guardrails?|checks?)\\b"},
    {"id": "other_customers_data", "technique": "policy_bypass", "weight": 3,
     "regex": "\\b(show|give|list|send|reveal|dump)\\b.{0,25}\\b(other|another|all|every)\\s+customers?'?s?\\b.{0,20}\\b(orders?|data|emails?|addresses|details|records|info)"},
    {"id": "chat_template_tokens", "technique": "instruction_override", "weight": 3,
     "regex": "<\\|?\\s*(im_start|im_end|system|endoftext|assistant)\\s*\\|?>|\\[/?(inst|sys|system)\\]|<<\\s*sys\\s*>>|<\\s*/?\\s*(system|instructions?)\\s*>"},
    {"id": "role_header_line", "technique": "instruction_override", "weight": 2,
     "regex": "\\b(system|assistant|developer)\\s*(prompt|message)?\\s*:\\s*\\S"},
    {"id": "fake_notice", "technique": "impersonation", "weight": 2,
     "regex": "\\b(system|admin|official|urgent|internal)\\s+(notice|notification|alert|update|override|directive|memo)\\b"},
    {"id": "claimed_policy_change", "technique": "policy_bypass", "weight": 2,
     "regex": "\\b(policy|policies|rules?)\\s+(has |have |was |were )?(been )?(updated|changed|revised)\\b.{0,80}\\b(approve|refund|discount|waive|exception)"},
    {"id": "from_now_on_must", "technique": "instruction_override", "weight": 2,
     "regex": "\\bfrom now on,?\\s+(you|the (assistant|bot|ai))\\s+(must|should|will|have to|are to)\\b"},
    {"id": "spoof_prompt_frame", "technique": "instruction_override", "weight": 3,
     "regex": "customer_message\\s*>>>|conversation_state\\s*:|<<<\\s*customer_message"},
    {"id": "spoof_classifier_output", "technique": "instruction_override", "weight": 3,
     "regex": "\"(contract_version|injection|intent|confidence)\"\\s*:|\\binjection\\.detected\\b|\"detected\"\\s*:\\s*false"},
    {"id": "suppress_flagging", "technique": "policy_bypass", "weight": 2,
     "regex": "\\b(do not|don't|never)\\b.{0,20}\\b(flag|escalate|report|log|classify|mention)\\b.{0,30}\\b(this|me|message|injection)"},
    {"id": "obfuscation_markers", "technique": "encoded_or_obfuscated", "weight": 1,
     "regex": "\\b(base64|rot13|hex[- ]?encoded|decode (this|the following)|in reverse)\\b"}
  ]
}
