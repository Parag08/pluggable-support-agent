# Copy to .env and adjust. Every key is required — the app will not start if one is missing.

# --- Database ---------------------------------------------------------------
# Local dev (no install needed):
DATABASE_URL=sqlite:///data/support_agent.db
# Postgres (see docker-compose.yml):
# DATABASE_URL=postgresql+psycopg://support_agent:change-me@localhost:5432/support_agent
DB_ECHO=false

# Used by docker-compose.yml to start Postgres (only needed when using Postgres)
POSTGRES_USER=support_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=support_agent
POSTGRES_PORT=5432

# --- Store / policy ---------------------------------------------------------
STORE_CURRENCY=USD
FREE_SHIPPING_THRESHOLD=100.00
STANDARD_SHIPPING_FEE=8.00
RETURN_WINDOW_DAYS=30

# --- Seed data --------------------------------------------------------------
# Directory with products.json, stores.json, size_chart.json, etc. (relative to the project root)
SEED_DATA_DIR=seed_data
SEED_RANDOM_SEED=42
SEED_NUM_CUSTOMERS=40
SEED_GUEST_CUSTOMER_RATIO=0.15
SEED_NUM_ORDERS=120
SEED_ORDER_HISTORY_DAYS=120
SEED_RETURN_RATE=0.18
SEED_OUT_OF_STOCK_RATE=0.12
SEED_RESTOCK_PROBABILITY=0.5
SEED_DISCOUNT_USAGE_RATE=0.2
SEED_CANCELLATION_RATE=0.04

# --- Telemetry --------------------------------------------------------------
# Store full (PII-redacted) LLM request/response bodies for every call.
TELEMETRY_STORE_LLM_PAYLOADS=true

# --- Inference (pluggable LLM provider) ------------------------------------
# Which provider plugin serves the model (see app/adapters/llm):
#   openai_compatible  any OpenAI-compatible API: Nous Portal, OpenAI, OpenRouter,
#                      Together, Groq, vLLM, Ollama, ... (set LLM_BASE_URL)
#   anthropic          Claude via the Anthropic Messages API (pip install anthropic)
#   pkg.module:Class   your own plugin implementing app.agent.llm.LLMClient
LLM_PROVIDER=openai_compatible
# Your provider's API key. This file is git-ignored: never commit it or paste it in chat.
# (anthropic: may be left empty to use ANTHROPIC_API_KEY or an `ant auth login` profile)
LLM_API_KEY=
# Provider endpoint. Empty = the provider's default (api.openai.com / api.anthropic.com).
# Examples: https://inference-api.nousresearch.com/v1 (Nous Portal)
#           https://openrouter.ai/api/v1 · http://localhost:11434/v1 (Ollama)
LLM_BASE_URL=https://inference-api.nousresearch.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# json_schema | json_object | prompt  (use what your provider supports;
# the classifier contract is validated in code either way)
LLM_JSON_MODE=json_schema
# Reasoning effort, for providers that support it (anthropic): low | medium | high | xhigh | max.
# Empty = the model's default. Ignored by openai_compatible.
LLM_EFFORT=

# Model IDs exactly as your provider lists them. Example for LLM_PROVIDER=anthropic:
#   CLASSIFIER_MODEL=claude-opus-5-5, LLM_EFFORT=low, and raise CLASSIFIER_MAX_TOKENS /
#   RESPONDER_MAX_TOKENS to ~4000 (thinking tokens count toward the limit).
# The *_TEMPERATURE keys are ignored by anthropic (current Claude models reject them).
CLASSIFIER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Vision-capable model for messages with images. Leave empty to reject images.
CLASSIFIER_VISION_MODEL=deepseek/deepseek-v4.1-flash-1017
CLASSIFIER_MAX_TOKENS=800
CLASSIFIER_TEMPERATURE=0
CLASSIFIER_MIN_CONFIDENCE=0.7
CLASSIFIER_MIN_CONFIDENCE_WRITE=0.85
CLASSIFIER_HISTORY_MESSAGES=4
CLASSIFIER_MAX_ENTITY_CHARS=300
# cascade only: use the local model at or above this confidence, for messages up to this long.
CASCADE_MIN_CONFIDENCE=0.8
CASCADE_MAX_CHARS=200

RESPONDER_MODEL=deepseek/deepseek-v4.1-flash-1017
RESPONDER_MAX_TOKENS=600
RESPONDER_TEMPERATURE=0.3
RESPONDER_MAX_REPLY_CHARS=900

# --- Ports and adapters (see docs/ARCHITECTURE.md) --------------------------
# Each *_PROVIDER is a built-in name, or '<python.module>:<ClassName>' for your own adapter.

# CommercePort: where the company's catalog, orders and returns live.
#   sql_reference  the demo database in this project
#   http_json      any system that exposes the JSON-over-HTTP contract (see README)
COMMERCE_PROVIDER=sql_reference
COMMERCE_HTTP_BASE_URL=
COMMERCE_HTTP_TOKEN=
COMMERCE_HTTP_TIMEOUT_SECONDS=15
# Extra attempts for a write that fails in transit (safe: every write has an idempotency key).
WRITE_RETRIES=1

# ClassifierPort: how a customer message becomes an intent.
#   llm_oneshot    one LLM call per message (uses the LLM_* settings above)
#   cascade        a fast local model for clear cases, the LLM for everything else
CLASSIFIER_PROVIDER=llm_oneshot

# IdentityPort: who the customer is.
#   signed_jwt     your site signs a short-lived token for the chat (set the IDENTITY_JWT_* keys)
#   dev            DEVELOPMENT ONLY: the "token" is just a customer id. Never use in production.
IDENTITY_PROVIDER=dev
IDENTITY_MAX_SESSION_MINUTES=60
# Where to send a signed-out customer; {session_id} is filled in. Empty = none.
IDENTITY_SIGN_IN_URL=
# signed_jwt: HS256 needs IDENTITY_JWT_SECRET; RS256/ES256 need IDENTITY_JWT_JWKS_URL.
IDENTITY_JWT_ALGORITHM=HS256
IDENTITY_JWT_SECRET=
IDENTITY_JWT_JWKS_URL=
IDENTITY_JWT_ISSUER=
IDENTITY_JWT_AUDIENCE=
# Which claim holds the customer id the commerce system knows (default: sub).
IDENTITY_JWT_CUSTOMER_CLAIM=sub
IDENTITY_JWT_MAX_AGE_SECONDS=300

# HandoffPort: where escalations go.
#   local          only the escalation record in this module's database
#   email          also email the summary and transcript to HANDOFF_EMAIL_TO over SMTP
HANDOFF_PROVIDER=local
HANDOFF_TRANSCRIPT_MESSAGES=30
HANDOFF_EMAIL_TO=
HANDOFF_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# --- Agent behaviour --------------------------------------------------------
# Company name used in prompts and reply templates
BRAND_NAME=Acme Footwear
# Prompts, intent catalog, templates, redaction rules (relative to the project root)
AGENT_CONFIG_DIR=agent_config
APP_VERSION=0.1.0
PROMPT_VERSION=2026-10-29.1
POLICY_CONFIG_VERSION=2026-10-29.1
MAX_MESSAGE_CHARS=2000
MAX_IMAGES_PER_MESSAGE=4
MAX_IMAGE_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
MAX_SLOT_ATTEMPTS=3
# Consecutive 'frustrated' turns before handing to a human
FRUSTRATION_ESCALATE_AFTER=2
MAX_EXCHANGES_PER_ITEM=1
ORDER_ID_PATTERN=^SS\d{5,}$
DISCOUNT_CODE_PATTERN=^[A-Z0-9]{3,20}$
CURRENCY_SYMBOL=$
ORDER_PICKER_LIMIT=5
PENDING_ACTION_TTL_MINUTES=15
IDENTITY_IDLE_TIMEOUT_MINUTES=30
RETURN_ID_PREFIX=RMA
RETURN_LABEL_URL_TEMPLATE=https://returns.example.com/labels/{return_id}.pdf

# --- Evals (evals/run_evals.py) ----------------------------------------------
# Each trial runs every case once against the live model; repeat to catch flaky behaviour.
EVAL_TRIALS=3
EVAL_WORKERS=6
